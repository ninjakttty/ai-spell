{
  "name": "ai-spell",
  "title": "AI Spell",
  "description": "Spelling suggestions through macOS Shortcuts and Apple Intelligence",
  "author": "Yuri",
  "license": "MIT",
  "icon": "command-icon.png",
  "version": "1.0.0",
  "categories": [
    "Productivity"
  ],
  "keywords": [
    "spell",
    "grammar",
    "ai",
    "apple silicon"
  ],
  "private": true,
  "scripts": {
    "dev": "ray dev",
    "build": "ray build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@raycast/api": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.10",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  },
  "commands": [
    {
      "name": "check-text",
      "title": "AI Spell",
      "description": "Get spelling suggestions and definitions through macOS Shortcuts",
      "mode": "view",
      "preferences": [
        {
          "name": "shortcutName",
          "type": "textfield",
          "title": "Siri Shortcut Name",
          "description": "Exact macOS Shortcut name to run",
          "default": "spelling",
          "required": false
        }
      ],
      "arguments": [
        {
          "name": "text",
          "type": "text",
          "placeholder": "Text to spell-check",
          "required": true
        }
      ]
    }
  ]
}
